# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kigali_coffee_lab
DB_USER=root
DB_PASSWORD=your_mysql_password
DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/kigali_coffee_lab

PORT=5050
# NODE_ENV=production   # set on the host; enables the strict checks below
# Comma-separated list of exact frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173
# Optional: origin printed into table QR stickers (defaults to the first FRONTEND_URL)
# PUBLIC_APP_URL=https://kigalicoffeelab.com
# Must point at a persistent disk/volume in production
UPLOADS_DIR=./uploads
# Generate each secret with:  openssl rand -hex 32   (production: 32+ chars, no placeholder words)
JWT_KEY=some_long_random_secret_for_jwt
# Only needed to log in accounts created before the bcrypt switch (they are
# re-hashed on next login). Keep the SAME value as before if you have existing users.
PASSWORD_KEY=some_long_random_secret_for_encrypting_passwords
# Number of reverse-proxy hops in front of the API (default 1 in production, 0 locally)
# TRUST_PROXY=1
# Max failed login/register attempts per IP per 15 minutes
# AUTH_RATE_LIMIT=20

# Production admin bootstrap only; set both before running npm run seed.
# INITIAL_ADMIN_EMAIL=admin@yourdomain.com
# INITIAL_ADMIN_PASSWORD=use_a_unique_password_at_least_16_characters_long
